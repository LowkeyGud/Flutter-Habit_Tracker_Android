{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lowkeygud.dev/schemas/portfolio/project.schema.json",
  "title": "Portfolio Project",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "slug",
    "title",
    "status",
    "ownership",
    "responsibilities",
    "overview",
    "features",
    "caseStudy",
    "aiMetadata"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "tagline": { "type": "string" },
    "description": { "type": "string" },
    "category": { "type": "string" },
    "type": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "active", "archived", "published"] },
    "year": { "type": ["integer", "string"] },
    "dates": {
      "type": "object",
      "properties": {
        "start": { "type": ["string", "null"] },
        "end": { "type": ["string", "null"] }
      }
    },
    "duration": { "type": "string" },
    "featured": { "type": "boolean" },
    "visibility": { "type": "string", "enum": ["public", "private", "unlisted"] },
    "ownership": {
      "type": "object",
      "required": ["type", "creator", "role", "endToEnd"],
      "properties": {
        "type": { "const": "solo" },
        "creator": { "type": "string" },
        "role": { "type": "string" },
        "endToEnd": { "type": "boolean" }
      }
    },
    "responsibilities": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "overview": {
      "type": "object",
      "properties": {
        "problem": { "type": "string" },
        "audience": { "type": "string" },
        "objectives": { "type": "array", "items": { "type": "string" } },
        "goals": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "valueProposition": { "type": "string" }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "status", "sourceFiles", "media"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "status": { "type": "string", "enum": ["planned", "in-progress", "done", "unknown"] },
          "userValue": { "type": "string" },
          "implementation": { "type": "string" },
          "sourceFiles": { "type": "array", "items": { "type": "string" } },
          "media": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "design": {
      "type": "object",
      "properties": {
        "visualDirection": { "type": "string" },
        "typography": { "type": "array", "items": { "type": "string" } },
        "colorPalette": { "type": "array", "items": { "type": "string" } },
        "interactionStyle": { "type": "string" },
        "designDecisions": { "type": "array", "items": { "type": "string" } },
        "designArtifacts": { "type": "array", "items": { "type": "string" } },
        "inspiration": { "type": "array", "items": { "type": "string" } },
        "iterations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "technology": {
      "type": "object",
      "properties": {
        "frontend": { "type": "array", "items": { "type": "string" } },
        "backend": { "type": "array", "items": { "type": "string" } },
        "database": { "type": "array", "items": { "type": "string" } },
        "stateManagement": { "type": "array", "items": { "type": "string" } },
        "animation": { "type": "array", "items": { "type": "string" } },
        "apis": { "type": "array", "items": { "type": "string" } },
        "integrations": { "type": "array", "items": { "type": "string" } },
        "deployment": { "type": "array", "items": { "type": "string" } },
        "testing": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "type": "string" } }
      }
    },
    "challenges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "problem", "solution"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "problem": { "type": "string" },
          "difficulty": { "type": "string" },
          "investigation": { "type": "string" },
          "approaches": { "type": "array", "items": { "type": "string" } },
          "solution": { "type": "string" },
          "implementation": { "type": "string" },
          "tradeoffs": { "type": "array", "items": { "type": "string" } },
          "outcome": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "sourceFiles": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "results": {
      "type": "object",
      "properties": {
        "verifiedMetrics": { "type": "array", "items": { "type": "string" } },
        "verifiedOutcomes": { "type": "array", "items": { "type": "string" } },
        "feedback": { "type": "array", "items": { "type": "string" } },
        "milestones": { "type": "array", "items": { "type": "string" } },
        "learnings": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "futureImprovements": { "type": "array", "items": { "type": "string" } }
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "live": { "type": ["string", "null"] },
        "github": { "type": ["string", "null"] },
        "documentation": { "type": ["string", "null"] },
        "demoVideo": { "type": ["string", "null"] },
        "appStore": { "type": ["string", "null"] },
        "googlePlay": { "type": ["string", "null"] },
        "related": { "type": "array", "items": { "type": "string" } },
        "external": { "type": "array", "items": { "type": "string" } }
      }
    },
    "seo": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "canonicalUrl": { "type": ["string", "null"] },
        "ogTitle": { "type": "string" },
        "ogDescription": { "type": "string" },
        "ogImage": { "type": ["string", "null"] },
        "twitterImage": { "type": ["string", "null"] },
        "keywords": { "type": "array", "items": { "type": "string" } }
      }
    },
    "caseStudy": {
      "type": "object",
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "$ref": "./case-study.schema.json#/$defs/section"
          }
        }
      }
    },
    "aiMetadata": {
      "type": "object",
      "required": ["generated", "generatedAt", "generator", "generationVersion", "reviewStatus"],
      "properties": {
        "generated": { "type": "boolean" },
        "generatedAt": { "type": ["string", "null"] },
        "generator": { "type": "string" },
        "generationVersion": { "type": "string" },
        "reviewStatus": { "type": "string", "enum": ["unknown", "generated", "draft", "human_reviewed", "approved", "published"] },
        "approvedAt": { "type": ["string", "null"] }
      }
    }
  }
}
