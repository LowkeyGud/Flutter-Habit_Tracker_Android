{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lowkeygud.dev/schemas/portfolio/case-study.schema.json",
  "title": "Portfolio Case Study",
  "type": "object",
  "$defs": {
    "section": {
      "type": "object",
      "required": ["id", "type", "title", "content", "media", "evidence", "visibility", "order"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "content": { "type": "string" },
        "media": { "type": "array", "items": { "type": "string" } },
        "layout": { "type": "string" },
        "visualDirection": { "type": "string" },
        "interaction": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "visibility": { "type": "string", "enum": ["hidden", "draft", "review", "published"] },
        "order": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "required": ["draftId", "projectId", "projectSlug", "workflowState", "sections", "aiMetadata"],
  "properties": {
    "draftId": { "type": "string" },
    "projectId": { "type": "string" },
    "projectSlug": { "type": "string" },
    "workflowState": { "type": "string", "enum": ["generated", "draft", "human_review", "approved", "published"] },
    "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } },
    "aiMetadata": {
      "type": "object",
      "required": ["generated", "generatedAt", "generator", "generationVersion", "reviewStatus"],
      "properties": {
        "generated": { "type": "boolean" },
        "generatedAt": { "type": ["string", "null"] },
        "generator": { "type": "string" },
        "generationVersion": { "type": "string" },
        "reviewStatus": { "type": "string" },
        "approvedAt": { "type": ["string", "null"] }
      }
    }
  }
}
